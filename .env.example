# Every variable the app reads. Copy to .env.local for development, and set
# the same names in the host's dashboard for a deployment.
#
# NEXT_PUBLIC_ ones are compiled into the browser bundle and are visible to
# anyone who looks. Nothing secret belongs on those lines — the anon key is
# meant to be public, and RLS is what actually protects the data.

# --- Supabase (required) -------------------------------------------------
# Project Settings → API. The anon key, never the service role key: that one
# bypasses RLS and must never reach the browser or this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Quotes (optional) ---------------------------------------------------
# Which provider src/lib/quotes.js uses. Unset means the Yahoo default.
# QUOTE_SOURCE=yahoo

# --- Page analytics (optional) -------------------------------------------
# Counts visitors who never sign in, which the in-app user_events table
# cannot see. Leave unset and no script is loaded at all.
#
# Plausible:
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
# NEXT_PUBLIC_ANALYTICS_DOMAIN=yourdomain.com
#
# Umami:
# NEXT_PUBLIC_ANALYTICS_SRC=https://cloud.umami.is/script.js
# NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=your-website-id

# --- Admin dashboard (optional, LOCAL ONLY) ------------------------------
# `npm run admin` shows signups, sign-ins and who your regulars are, at
# http://127.0.0.1:7788. It reads every user's row, so it needs the service
# role key: Supabase -> Project Settings -> API -> "service_role".
#
# That key bypasses row-level security. It belongs in .env.local on your own
# machine and NOWHERE else -- not on Vercel, not in a commit. The dashboard is
# a plain Node script outside the app precisely so this key never ships.
SUPABASE_SERVICE_ROLE_KEY=

# Your own logins, left out of Pulse's figures — comma separated, no spaces
# needed. Five test accounts against twenty real ones moves retention and the
# day board in the flattering direction. Your addresses stay in .env.local;
# this file is committed and carries only the name.
ADMIN_EXCLUDE=
